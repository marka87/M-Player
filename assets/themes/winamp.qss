/* Winamp 2026 (Windows 11 + Bento + Spotify) */

QMainWindow, QWidget#centralWidget { 
    background-color: #0B0D11; 
    color: #FFFFFF; 
    font-family: "Segoe UI Variable", "Segoe UI", system-ui, sans-serif; 
    font-size: 14px; 
}

/* SIDEBAR */
QFrame#sidebarFrame { 
    background-color: rgba(21, 26, 33, 180); /* Leichte Transparenz */
    border-right: 1px solid #262E38; 
    min-width: 250px; 
    max-width: 250px; 
}

QListWidget#sidebarNav { 
    background-color: transparent; 
    border: none; 
    outline: none; 
    padding: 10px;
}
QListWidget#sidebarNav::item { 
    color: #A0A6AD; 
    min-height: 48px; max-height: 48px; 
    padding-left: 12px; margin: 4px 8px; 
    border-radius: 8px; 
    font-size: 15px; font-weight: 600; 
}
QListWidget#sidebarNav::item:hover { 
    background-color: #20262F; 
    color: #FFFFFF; 
}
QListWidget#sidebarNav::item:selected { 
    background-color: rgba(61, 220, 99, 0.15); /* Glow background */
    color: #3DDC63; 
    font-weight: 700; 
    border: 1px solid rgba(61, 220, 99, 0.3); /* Leichter Rahmen als Glow */
}

/* BIBLIOTHEK */
QTableView, QListWidget { 
    background-color: #151A21; 
    border: 1px solid #262E38; 
    border-radius: 12px; 
    selection-background-color: #20262F; 
    selection-color: #3DDC63; 
    gridline-color: transparent;
    outline: none; 
}
QTableView::item { 
    border-bottom: 1px solid #262E38; 
    padding: 8px 12px; 
    color: #FFFFFF; 
}
QTableView::item:hover { 
    background-color: #20262F; 
}
QTableView::item:selected { 
    background-color: #20262F; 
    color: #3DDC63; 
}
QHeaderView::section { 
    background-color: #0B0D11; 
    color: #A0A6AD; 
    border: none; 
    border-bottom: 1px solid #262E38; 
    padding: 10px 12px; 
    font-weight: 600; 
    font-size: 13px; 
}

/* BUTTONS & TOOLBAR */
QPushButton { 
    background-color: transparent; 
    border: none; 
    border-radius: 8px; 
    min-height: 36px; padding: 6px 14px; 
    color: #FFFFFF; font-size: 14px; font-weight: 500; 
}
QPushButton:hover { 
    background-color: #20262F; 
}
QPushButton:pressed { 
    background-color: #151A21; 
}

/* Primary Button / Play Button */
QPushButton#playPauseBtn { 
    background-color: #3DDC63; 
    border-radius: 28px; 
    min-width: 56px; min-height: 56px; max-width: 56px; max-height: 56px; 
    padding: 0;
}
QPushButton#playPauseBtn:hover { 
    background-color: #48E76E; 
    border: 2px solid rgba(61, 220, 99, 0.5); /* Glow */
}
QPushButton#accent { 
    background-color: #3DDC63; border-radius: 8px; color: #121212; font-weight: 600; 
}
QPushButton#accent:hover { background-color: #48E76E; }

/* PLAYER BAR */
QFrame#playerBar { 
    background-color: rgba(5, 7, 10, 0.85); /* Schwarze Glasfläche */
    border: 1px solid #262E38; 
    border-radius: 16px; 
    margin: 10px;
}
/* Display Screen inside Player */
QFrame#playerBar QWidget {
    color: #FFFFFF;
}

/* SLIDERS */
QSlider::groove:horizontal { 
    border: none; 
    height: 6px; background: #262E38; border-radius: 3px; 
}
QSlider::sub-page:horizontal { 
    background: #3DDC63; 
    border-radius: 3px; 
}
QSlider::handle:horizontal { 
    background: #FFFFFF; 
    border: none; width: 14px; height: 14px; margin: -4px 0; border-radius: 7px; 
}
QSlider::handle:horizontal:hover { width: 16px; height: 16px; margin: -5px 0; background: #3DDC63; }

/* INPUTS & CARDS */
QFrame#card, QFrame#toolbarFrame, QFrame#detailsPanel { 
    background-color: rgba(21, 26, 33, 200); /* Acrylic / Glass */
    border: 1px solid #262E38; 
    border-radius: 12px; 
}
QLineEdit, QComboBox { 
    background-color: #0B0D11; 
    border: 1px solid #262E38; 
    border-radius: 8px; 
    min-height: 38px; padding: 6px 12px; 
    color: #FFFFFF; 
}
QLineEdit:focus, QComboBox:focus {
    border-color: #3DDC63;
}

QLabel#secondary { color: #A0A6AD; }
QLabel#metaBadge { background-color: #20262F; color: #3DDC63; border: 1px solid #262E38; border-radius: 6px; padding: 4px 8px; font-weight: 600; }

/* Menus */
QMenu { background-color: #151A21; border: 1px solid #262E38; border-radius: 8px; color: #FFFFFF; padding: 4px; }
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 4px; margin: 2px; }
QMenu::item:selected { background-color: #20262F; color: #3DDC63; }
