/* Winamp Bento / Modern Skin - Mica & Glow */
QMainWindow, QWidget#centralWidget { 
    background-color: rgba(10, 10, 10, 200); /* Translucent for Mica effect if enabled */
    color: #00FF00; 
    font-family: "Segoe UI", sans-serif; 
    font-size: 14px; 
}

/* 7. Sidebar */
QFrame#sidebarFrame { 
    background-color: rgba(20, 20, 20, 180); 
    border-right: 1px solid #333; 
    min-width: 240px; 
    max-width: 240px; 
}
QListWidget#sidebarNav { background-color: transparent; border: none; outline: none; }
QListWidget#sidebarNav::item { 
    color: #AAAAAA; 
    min-height: 40px; max-height: 40px; 
    padding-left: 10px; margin: 2px 0px; 
    font-size: 15px; font-weight: bold; 
    border-left: 4px solid transparent; 
}
QListWidget#sidebarNav::item:hover { 
    background-color: rgba(34, 34, 34, 150); 
    color: #00FF00; 
    border-left: 4px solid #00FF00; /* Grüner Glow */
}
QListWidget#sidebarNav::item:selected { 
    background-color: rgba(51, 51, 51, 200); 
    color: #00FF00; 
    border-left: 4px solid #00FF00; 
}

/* 5. Bibliothek / 9. Cover Wall */
QTableView, QListWidget { 
    background-color: rgba(15, 15, 15, 200); 
    border: 1px solid #333; 
    border-radius: 8px; 
    selection-background-color: #003300; 
    selection-color: #00FF00; 
    outline: none; 
}
QTableView::item { border-bottom: 1px solid #111; padding: 4px 8px; color: #EEEEEE; }
QTableView::item:hover { background-color: #1A1A1A; }
QTableView::item:selected { background-color: #003300; color: #00FF00; }
QHeaderView::section { background-color: #222; color: #AAA; border: none; border-bottom: 1px solid #444; padding: 6px 10px; font-weight: bold; font-size: 12px; }

/* Mini Toolbar & Buttons */
QPushButton { 
    background-color: rgba(30, 30, 30, 200); 
    border: 1px solid #444; 
    border-radius: 4px; 
    min-height: 28px; padding: 4px 12px; 
    color: #DDD; font-size: 13px; font-weight: bold; 
}
QPushButton:hover { 
    background-color: #333; 
    border-color: #00FF00; /* Glow */
    color: #00FF00; 
}
QPushButton:pressed { background-color: #111; }
QPushButton#accent { background-color: #004400; border: 1px solid #00FF00; color: #00FF00; }
QPushButton#accent:hover { background-color: #006600; }

/* 2. Player Buttons */
QPushButton#playPauseBtn { 
    border-radius: 26px; 
    min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; 
    background-color: #003300; border: 2px solid #00FF00; 
}
QPushButton#playPauseBtn:hover { background-color: #005500; box-shadow: 0 0 10px #00FF00; }

QPushButton#playerBtn { border-radius: 20px; background: transparent; border: none; }
QPushButton#playerBtn:hover { background: #222; border: 1px solid #00FF00; }

/* Cards & Mica */
QFrame#card, QFrame#toolbarFrame, QFrame#detailsPanel, QFrame#playerBar { 
    background-color: rgba(20, 20, 20, 180); 
    border: 1px solid #333; 
    border-radius: 10px; 
}

/* Inputs */
QLineEdit, QComboBox { 
    background-color: rgba(0, 0, 0, 200); 
    border: 1px solid #444; 
    border-radius: 4px; 
    min-height: 28px; padding: 4px 8px; 
    color: #00FF00; 
}

/* 3. Analog Zeitbalken */
QSlider::groove:horizontal { border: none; height: 6px; background: #222; border-radius: 3px; }
QSlider::sub-page:horizontal { 
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #005500, stop:1 #00FF00); 
    border-radius: 3px; 
}
QSlider::handle:horizontal { 
    background: #00FF00; 
    border: none; width: 12px; height: 12px; margin: -3px 0; border-radius: 6px; 
}
QSlider::handle:horizontal:hover { width: 14px; height: 14px; margin: -4px 0; background: #AAFFAA; }

QLabel#secondary { color: #888; }
QLabel#metaBadge { background-color: #003300; color: #00FF00; border: 1px solid #00FF00; border-radius: 4px; padding: 2px 6px; }

/* Menu */
QMenu { background-color: rgba(20, 20, 20, 230); border: 1px solid #444; border-radius: 6px; }
QMenu::item { color: #EEE; padding: 6px 20px; }
QMenu::item:selected { background-color: #003300; color: #00FF00; }
