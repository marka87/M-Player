/* Winamp Classic Skin 1997 - Authentic Look */

QMainWindow, QWidget#centralWidget { 
    background-color: #171822; /* Winamp Slate Dark */
    color: #00FF00; 
    font-family: "Courier New", "Lucida Console", monospace; 
    font-size: 13px; 
}

/* 1. SIDEBAR */
QFrame#sidebarFrame { 
    background-color: #242635; /* Winamp Base */
    border: 2px outset #5C5E78; /* 3D Bevel */
    min-width: 240px; 
    max-width: 240px; 
}

QListWidget#sidebarNav { 
    background-color: #000000; 
    border: 2px inset #444; 
    margin: 4px;
}
QListWidget#sidebarNav::item { 
    color: #00FF00; 
    min-height: 28px; max-height: 28px; 
    padding-left: 8px; 
    font-weight: bold; 
}
QListWidget#sidebarNav::item:hover { 
    background-color: #222222; 
}
QListWidget#sidebarNav::item:selected { 
    background-color: #000088; /* Classic Winamp Select Blue */
    color: #FFFFFF; 
}

/* 2. BIBLIOTHEK / PLAYLIST (Winamp Playlist Look) */
QTableView, QListWidget { 
    background-color: #000000; 
    border: 2px inset #5C5E78; 
    selection-background-color: #0000AA; 
    selection-color: #FFFFFF; 
    gridline-color: transparent;
    color: #00FF00;
}
QTableView::item { border-bottom: none; padding: 2px 6px; }
QTableView::item:selected { background-color: #0000AA; color: #FFFFFF; }
QHeaderView::section { 
    background-color: #C3C7D3; /* Silver Button */
    color: #000000; 
    border: 2px outset #DFE3EE; 
    padding: 2px 6px; 
    font-family: "Arial", sans-serif;
    font-size: 11px;
    font-weight: bold; 
}

/* 3. BUTTONS (Silver 3D Look) */
QPushButton { 
    background-color: #C3C7D3; 
    border: 2px outset #DFE3EE; 
    border-radius: 0px; 
    min-height: 24px; padding: 2px 10px; 
    color: #000000; font-family: "Arial", sans-serif; font-size: 11px; font-weight: bold; 
}
QPushButton:pressed { 
    border: 2px inset #DFE3EE; 
    background-color: #A3A7B3; 
    padding: 3px 9px 1px 11px; /* Shift text for 3D press */
}

/* Spezielle Player-Buttons (Shuffle, Vorher, Play, etc.) */
QPushButton#playerBtn, QPushButton#playPauseBtn {
    background-color: #C3C7D3; 
    border: 2px outset #DFE3EE; 
    border-radius: 0px; 
}
QPushButton#playerBtn:pressed, QPushButton#playPauseBtn:pressed {
    border: 2px inset #DFE3EE; 
    background-color: #A3A7B3; 
}
QPushButton#accent { background-color: #C3C7D3; border: 2px outset #DFE3EE; color: #000000; }
QPushButton#accent:pressed { border: 2px inset #DFE3EE; }

/* 4. PLAYER BAR (Winamp Main Window) */
QFrame#playerBar { 
    background-color: #242635; 
    border: 2px outset #5C5E78; 
    border-radius: 0px; 
}
/* Display Screen inside Player */
QFrame#playerBar QWidget {
    color: #00FF00;
}

/* 5. SLIDERS (Timeline orange/brownish, Volume green) */
QSlider::groove:horizontal { 
    border: 1px inset #444; 
    height: 8px; background: #000000; 
}
QSlider::sub-page:horizontal { 
    background: #E58700; /* Winamp Orange */
}
QSlider::handle:horizontal { 
    background: #C3C7D3; 
    border: 2px outset #DFE3EE; 
    width: 14px; height: 16px; margin: -5px 0; 
}

/* Volume Slider */
QSlider#volumeSlider::sub-page:horizontal { background: #00FF00; }

/* 6. INPUTS & CARDS */
QFrame#card, QFrame#toolbarFrame, QFrame#detailsPanel { 
    background-color: #242635; 
    border: 2px outset #5C5E78; 
    border-radius: 0px; 
}
QLineEdit, QComboBox { 
    background-color: #000000; 
    border: 2px inset #5C5E78; 
    border-radius: 0px; 
    color: #00FF00; 
}
QLabel#secondary { color: #00AA00; }

/* Menus */
QMenu { background-color: #C3C7D3; border: 2px outset #DFE3EE; color: #000000; font-family: "Arial", sans-serif; }
QMenu::item { padding: 4px 16px; }
QMenu::item:selected { background-color: #0000AA; color: #FFFFFF; }
