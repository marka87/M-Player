/* =========================================================
   M-Player UI Polish v1.1 — Windows 11 / Spotify Dark Theme
   ========================================================= */

QMainWindow, QWidget#centralWidget {
    background-color: #111315;
    color: #F4F4F4;
    font-family: "Segoe UI Variable", "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
}

/* =========================================================
   1. SIDEBAR (240px, 48px item height, 8px spacing, left-aligned)
   ========================================================= */
QFrame#sidebarFrame {
    background-color: #171A1F;
    border-right: 1px solid #262B34;
    min-width: 240px;
    max-width: 240px;
}

QListWidget#sidebarNav {
    background-color: transparent;
    border: none;
    outline: none;
    padding-top: 8px;
}

QListWidget#sidebarNav QScrollBar:vertical {
    width: 0px;
    height: 0px;
}

QListWidget#sidebarNav::item {
    color: #A0A6AD;
    min-height: 48px;
    max-height: 48px;
    padding-left: 18px;
    margin: 3px 8px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    border-left: 4px solid transparent;
}

QListWidget#sidebarNav::item:hover {
    background-color: #252B34;
    color: #F4F4F4;
    border-left: 4px solid transparent;
}

QListWidget#sidebarNav::item:selected {
    background-color: #203126;
    color: #3DDC63;
    font-weight: 700;
    border-left: 4px solid #3DDC63;
}

/* =========================================================
   2. CHECKBOXES (18x18px, rounded 4px, dark bg #2a2e38, #4b5563 border, #1db954 checked)
   ========================================================= */
QCheckBox {
    color: #E0E0E0;
    font-size: 13px;
    min-height: 24px;
    spacing: 10px;
}

QCheckBox::indicator, QTableView::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #4B5563;
    border-radius: 4px;
    background-color: #2A2E38;
}

QCheckBox::indicator:unchecked:hover, QTableView::indicator:unchecked:hover {
    border: 1px solid #1DB954;
    background-color: #323742;
}

QCheckBox::indicator:checked, QTableView::indicator:checked {
    border: 1px solid #1DB954;
    border-radius: 4px;
    background-color: #1DB954;
    image: url(assets/icons/check.svg);
}

QCheckBox::indicator:checked:hover, QTableView::indicator:checked:hover {
    border-color: #1ED760;
    background-color: #1ED760;
}

/* =========================================================
   3. BUTTONS (Primary #1DB954 font 600, Secondary #1E232A border #333842)
   ========================================================= */
QPushButton {
    background-color: #1E232A;
    border: 1px solid #333842;
    border-radius: 8px;
    min-height: 38px;
    padding: 8px 16px;
    color: #E0E0E0;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #282E38;
    border-color: #4B5563;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #171A1F;
}

QPushButton#accent {
    background-color: #1DB954;
    border: none;
    border-radius: 8px;
    color: #121212;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
    padding: 8px 20px;
}

QPushButton#accent:hover {
    background-color: #1ED760;
    color: #121212;
}

QPushButton#accent:pressed {
    background-color: #179E46;
    color: #121212;
}

QPushButton#danger {
    background-color: #5C1E24;
    border: 1px solid #82272F;
    border-radius: 8px;
    color: #F8D7DA;
    min-height: 38px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton#danger:hover {
    background-color: #782730;
    border-color: #A0323C;
}

QPushButton#toolbarBtn {
    background-color: #1E232A;
    border: 1px solid #333842;
    border-radius: 8px;
    min-height: 36px;
    padding: 6px 14px;
    color: #E0E0E0;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#toolbarBtn:hover {
    background-color: #282E38;
    border-color: #1DB954;
    color: #FFFFFF;
}

QPushButton#toolbarBtn[active="true"] {
    background-color: #203126;
    border-color: #1DB954;
    color: #1DB954;
    font-weight: 600;
}

QPushButton#playerBtn {
    background-color: transparent;
    border: none;
    border-radius: 21px;
    min-width: 42px;
    min-height: 42px;
    max-width: 42px;
    max-height: 42px;
    padding: 0px;
}

QPushButton#playerBtn:hover {
    background-color: #252B34;
}

QPushButton#playPauseBtn {
    background-color: #3DDC63;
    border: none;
    border-radius: 26px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    padding: 0px;
}

QPushButton#playPauseBtn:hover {
    background-color: #48E76E;
}

/* =========================================================
   4. BIBLIOTHEK QTABLEVIEW (#151920, Hover #20262F, Sel #21412D)
   ========================================================= */
QTableView {
    background-color: #151920;
    border: 1px solid #262B34;
    border-radius: 14px;
    gridline-color: transparent;
    selection-background-color: #21412D;
    selection-color: #F4F4F4;
    outline: none;
}

QTableView::item {
    background-color: #151920;
    border-bottom: 1px solid #1E232B;
    padding: 4px 8px;
    color: #F4F4F4;
}

QTableView::item:hover {
    background-color: #20262F;
}

QTableView::item:selected {
    background-color: #21412D;
    color: #F4F4F4;
}

QHeaderView::section {
    background-color: #171A1F;
    color: #A0A6AD;
    border: none;
    border-bottom: 1px solid #262B34;
    padding: 6px 10px;
    min-height: 36px;
    font-weight: 600;
    font-size: 12px;
}

/* =========================================================
   5. CARDS, TOOLBARS & DASHBOARD STATS
   ========================================================= */
QFrame#card {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 14px;
}

QFrame#toolbarFrame {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
    padding: 6px 12px;
}

QFrame#statBadge {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 12px;
    padding: 8px 16px;
}

QLabel#statValue {
    color: #3DDC63;
    font-size: 16px;
    font-weight: 700;
}

QLabel#statLabel {
    color: #A0A6AD;
    font-size: 12px;
}

/* =========================================================
   6. INPUTS & SEARCH
   ========================================================= */
QLineEdit, QComboBox {
    background-color: #181B20;
    border: 1px solid #2E3440;
    border-radius: 8px;
    min-height: 40px;
    padding: 10px 14px;
    color: #F4F4F4;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #1DB954;
    background-color: #242831;
}

QLineEdit#searchBar {
    font-size: 13px;
    min-height: 36px;
    background-color: #181B20;
    border: 1px solid #2E3440;
    border-radius: 8px;
    padding: 8px 14px;
}

QLineEdit#searchBar:focus {
    border-color: #1DB954;
    background-color: #242831;
}

/* =========================================================
   7. SLIDERS & PROGRESS BAR
   ========================================================= */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #262B34;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #3DDC63;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F4F4F4;
    border: none;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #3DDC63;
}

QProgressBar {
    border: none;
    border-radius: 5px;
    background-color: #20262F;
    min-height: 10px;
    max-height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3DDC63;
    border-radius: 5px;
}

/* =========================================================
   8. MINI PLAYER
   ========================================================= */
QFrame#playerBar {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
    padding: 8px 14px;
}

/* =========================================================
   9. MENUS & DIALOGS
   ========================================================= */
QMenu {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    color: #F4F4F4;
    padding: 8px 24px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #252B34;
    color: #3DDC63;
}

QDialog {
    background-color: #171A1F;
    color: #F4F4F4;
    border: 1px solid #262B34;
    border-radius: 14px;
}

/* =========================================================
   10. SCROLLBARS
   ========================================================= */
QScrollBar:vertical {
    border: none;
    background: #111315;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #262B34;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #333A46;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* =========================================================
   11. DETAILS PANEL & META BADGES
   ========================================================= */
QFrame#detailsPanel {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
    min-width: 300px;
    max-width: 300px;
}

QFrame#metaBox {
    background-color: #14161B;
    border: 1px solid #222730;
    border-radius: 10px;
}

QLabel#metaBadge {
    background-color: #203126;
    color: #3DDC63;
    border: 1px solid #2B4734;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#closeBtn {
    background-color: transparent;
    border: none;
    color: #A0A6AD;
    font-size: 15px;
    font-weight: bold;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
    max-width: 28px;
    border-radius: 14px;
    padding: 0px;
}

QPushButton#closeBtn:hover {
    background-color: #252B34;
    color: #F4F4F4;
}

/* =========================================================
   12. FILTER CHIPS
   ========================================================= */
QFrame#chipBar {
    background-color: transparent;
    border: none;
    padding: 2px 0px;
}

QPushButton#chipBtn {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 16px;
    min-height: 32px;
    max-height: 32px;
    padding: 4px 14px;
    color: #A0A6AD;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#chipBtn:hover {
    background-color: #252B34;
    color: #F4F4F4;
    border-color: #3DDC63;
}

QPushButton#chipBtn[active="true"] {
    background-color: #203126;
    border: 1px solid #3DDC63;
    color: #3DDC63;
    font-weight: 700;
}

/* =========================================================
   13. DOWNLOAD STAT CARDS & PLAYLIST HEADER
   ========================================================= */
QFrame#dlStatCard {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 12px;
    padding: 8px 14px;
}

QFrame#dlStatCard:hover {
    background-color: #1C2026;
    border-color: #333A46;
}

QFrame#playlistHeaderCard {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
}

/* =========================================================
   14. SETTINGS SCROLL AREA
   ========================================================= */
QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget {
    background: transparent;
}

