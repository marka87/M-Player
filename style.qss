/* =========================================================
   Windows 11 / Spotify Dark Theme for M-Player
   ========================================================= */

QMainWindow, QWidget#centralWidget {
    background-color: #111315;
    color: #F4F4F4;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 14px;
}

/* Sidebar */
QFrame#sidebarFrame {
    background-color: #171A1F;
    border-right: 1px solid #262B34;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
}

QListWidget#sidebarNav {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#sidebarNav::item {
    color: #A0A6AD;
    padding: 12px 16px;
    margin: 4px 10px;
    border-radius: 10px;
    font-weight: 500;
}

QListWidget#sidebarNav::item:hover {
    background-color: #262B34;
    color: #F4F4F4;
}

QListWidget#sidebarNav::item:selected {
    background-color: #223727;
    color: #3DDC63;
    font-weight: 700;
}

/* Cards & Panels */
QFrame#card {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 14px;
}

QFrame#cardHeader {
    border-bottom: 1px solid #262B34;
}

/* Buttons */
QPushButton {
    background-color: #262B34;
    border: 1px solid #333A46;
    border-radius: 10px;
    padding: 8px 16px;
    color: #F4F4F4;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #333A46;
    border-color: #444E5E;
}

QPushButton:pressed {
    background-color: #1C2026;
}

QPushButton#accent {
    background-color: #3DDC63;
    border: none;
    color: #0B1E10;
    font-weight: 700;
}

QPushButton#accent:hover {
    background-color: #48E76E;
}

QPushButton#accent:pressed {
    background-color: #33BD54;
}

QPushButton#danger {
    background-color: #5C1E24;
    border: 1px solid #82272F;
    color: #F8D7DA;
}

QPushButton#danger:hover {
    background-color: #782730;
}

QPushButton#playerBtn {
    background-color: transparent;
    border: none;
    border-radius: 18px;
    font-size: 16px;
    padding: 6px;
    color: #A0A6AD;
}

QPushButton#playerBtn:hover {
    background-color: #262B34;
    color: #F4F4F4;
}

QPushButton#playPauseBtn {
    background-color: #3DDC63;
    color: #0B1E10;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
}

QPushButton#playPauseBtn:hover {
    background-color: #48E76E;
}

/* Inputs & Search */
QLineEdit, QComboBox {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 12px;
    padding: 10px 14px;
    color: #F4F4F4;
    selection-background-color: #3DDC63;
    selection-color: #0B1E10;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3DDC63;
    background-color: #1C2026;
}

QLineEdit#searchBar {
    font-size: 15px;
    padding: 12px 18px;
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
}

QLineEdit#searchBar:focus {
    border-color: #3DDC63;
    background-color: #1C2026;
}

/* Tables */
QTableView {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
    gridline-color: transparent;
    selection-background-color: #203B26;
    selection-color: #F4F4F4;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid #21262F;
    padding: 4px 8px;
}

QTableView::item:hover {
    background-color: #242A33;
}

QTableView::item:selected {
    background-color: #203B26;
}

QHeaderView::section {
    background-color: #171A1F;
    color: #A0A6AD;
    border: none;
    border-bottom: 1px solid #262B34;
    padding: 10px 12px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #262B34;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #3DDC63;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F4F4F4;
    border: none;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #3DDC63;
}

/* Progress Bar */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #262B34;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3DDC63;
    border-radius: 6px;
}

/* Labels */
QLabel {
    color: #F4F4F4;
}

QLabel#secondary {
    color: #A0A6AD;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: 700;
    color: #F4F4F4;
}

/* Mini Player Bar */
QFrame#playerBar {
    background-color: #171A1F;
    border: 1px solid #262B34;
    border-radius: 14px;
    padding: 6px;
}

/* Menus & Dialogs */
QMenu {
    background-color: #1C2026;
    border: 1px solid #262B34;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    color: #F4F4F4;
    padding: 8px 24px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #262B34;
    color: #3DDC63;
}

QScrollBar:vertical {
    border: none;
    background: #111315;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #262B34;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #333A46;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
